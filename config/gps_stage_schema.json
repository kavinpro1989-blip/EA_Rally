{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gps_stage_schema.json",
  "title": "GPS rally stage",
  "description": "A rally special stage described by parallel WGS84 arrays. Lengths of lat, lng, elevation (and width / bank if present) must match. The parser converts them to a local 3D Cartesian spline (x = East, y = Up, z = -North).",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "track"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "type": "string"
    },
    "datum": {
      "enum": [
        "WGS84"
      ]
    },
    "seed": {
      "type": "integer",
      "description": "Seeds procedural banking noise and stone strikes for this stage."
    },
    "origin": {
      "$ref": "#/definitions/geoPoint"
    },
    "track": {
      "type": "object",
      "required": [
        "lat",
        "lng",
        "elevation"
      ],
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          }
        },
        "lng": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "elevation": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "number",
            "minimum": -500,
            "maximum": 9000
          }
        },
        "width": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "number",
            "exclusiveMinimum": 2,
            "maximum": 30
          }
        },
        "bank": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "number",
            "minimum": -25,
            "maximum": 25
          },
          "description": "Optional measured road banking per point in degrees (positive = right side lower). Overrides procedural banking where given."
        },
        "closed": {
          "type": "boolean"
        }
      }
    },
    "road": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultWidth": {
          "type": "number",
          "exclusiveMinimum": 2,
          "maximum": 30
        },
        "crownSlope": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.12,
          "description": "Cross-fall from crown to edge as m/m."
        },
        "shoulderWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "shoulderLayers": {
          "$ref": "#/definitions/layers"
        },
        "verge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "slope": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "width": {
              "type": "number",
              "minimum": 0,
              "maximum": 40
            },
            "layers": {
              "$ref": "#/definitions/layers"
            }
          }
        },
        "defaultLayers": {
          "$ref": "#/definitions/layers"
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sampleSpacing": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 5
        },
        "horizontalSmoothing": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "description": "Gaussian sigma [m] applied to the horizontal path (GPS noise)."
        },
        "elevationSmoothing": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Gaussian sigma [m] applied to elevation."
        },
        "curvatureSmoothing": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "designSpeed": {
          "type": "number",
          "minimum": 5,
          "maximum": 80,
          "description": "Speed [m/s] used to size procedural banking."
        },
        "bankFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxBankDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "bankNoiseDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "bankNoiseWavelength": {
          "type": "number",
          "minimum": 10,
          "maximum": 500
        },
        "verticalCurvatureSmoothing": {
          "type": "number",
          "minimum": 0,
          "maximum": 60,
          "description": "Gaussian sigma [m] applied to elevation before computing vertical curvature (crest / dip detection)."
        },
        "apexCurvatureSmoothing": {
          "type": "number",
          "minimum": 0,
          "maximum": 40,
          "description": "Gaussian sigma [m] of the robust curvature used for corner radius / severity (rejects GPS jitter)."
        }
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fromDistance",
          "toDistance",
          "layers"
        ],
        "additionalProperties": false,
        "properties": {
          "fromDistance": {
            "type": "number",
            "minimum": 0
          },
          "toDistance": {
            "type": "number",
            "minimum": 0
          },
          "layers": {
            "$ref": "#/definitions/layers"
          }
        }
      }
    },
    "pacenotes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "explicit",
            "merge"
          ]
        },
        "severityScale": {
          "enum": [
            "six_easiest",
            "one_easiest"
          ]
        },
        "leadTimeSeconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 15
        },
        "minLeadDistance": {
          "type": "number",
          "minimum": 10,
          "maximum": 400
        },
        "speechRate": {
          "type": "number",
          "minimum": 1,
          "maximum": 8,
          "description": "Words per second used to estimate how long a call takes."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "distance",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "distance": {
                "type": "number",
                "minimum": 0
              },
              "type": {
                "enum": [
                  "left",
                  "right",
                  "straight",
                  "crest",
                  "jump",
                  "dip",
                  "bump",
                  "caution",
                  "finish",
                  "custom"
                ]
              },
              "severity": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "text": {
                "type": "string"
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              }
            }
          }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "distance",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "distance": {
            "type": "number",
            "minimum": 0
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  },
  "definitions": {
    "geoPoint": {
      "type": "object",
      "required": [
        "lat",
        "lng"
      ],
      "additionalProperties": false,
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "elevation": {
          "type": "number"
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "depth": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}